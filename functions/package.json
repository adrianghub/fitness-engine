{
  "name": "functions",
  "scripts": {
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf lib",
    "prebuild": "pnpm run clean && pnpm run generate:types && mkdir -p lib",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "pnpm run build && firebase emulators:start --only functions",
    "shell": "pnpm run build && firebase functions:shell",
    "start": "pnpm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "generate:types": "typesync generate-ts --definition '../schema-definitions/**/*.yml' --target firebase-admin@13 --outFile src/types/models.ts",
    "test": "vitest"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@genkit-ai/googleai": "^1.6.0",
    "@google-cloud/functions-framework": "^4.0.0",
    "dayjs": "^1.11.13",
    "firebase-admin": "^13.2.0",
    "firebase-functions": "^6.3.2",
    "genkit": "^1.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "eslint": "^9.23.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.31.0",
    "firebase-functions-test": "^3.4.1",
    "globals": "^16.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "typesync-cli": "^0.13.0"
  },
  "private": true
}
