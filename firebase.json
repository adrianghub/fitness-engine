{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "pnpm --prefix \"$RESOURCE_DIR\" install",
        "pnpm --prefix \"$RESOURCE_DIR\" lint",
        "pnpm --prefix \"$RESOURCE_DIR\" build"
      ]
    }
  ],
  "hosting": {
    "site": "fitness-engine-a3383",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099,
      "cors": "emulator-cors.json"
    },
    "functions": {
      "port": 5001,
      "cors": "emulator-cors.json"
    },
    "firestore": {
      "port": 8080,
      "cors": "emulator-cors.json"
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
